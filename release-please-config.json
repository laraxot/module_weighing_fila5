{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "5b76cffc1",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "fixcity-platform",
      "extra-files": []
    }
  },
  "_comment_monorepo": "Per estendere il versioning ai singoli moduli Laraxot, aggiungere voci in 'packages', es. 'laravel/Modules/User': { 'release-type': 'php', 'component': 'user' }. Richiede commit con scope corrispondente (feat(user): ...) e abilitazione del plugin 'linked-versions' se si vogliono versioni allineate."
}
