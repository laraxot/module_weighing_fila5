# Poolside CLI Context Optimisation
# Generated 2026-05-14
# Purpose: fix "Input length 133035 exceeds 131040 tokens" by excluding
# bulky / generated / vendor files from automatic context attachment.
# Mirrors .kiloignore — both CLIs ingest the project tree and share the same
# context-size pressure.
#
# Reference: docs/wiki/memories/feedback_kilo_cli_context_over_flow.md

# Dependencies (lock files + binaries dominate token counts)
node_modules/
*/node_modules/
*/package-lock.json
*/pnpm-lock.yaml
*/yarn.lock
*/composer.lock
package-lock.json
pnpm-lock.yaml
yarn.lock
composer.lock

# Vendor dirs (Composer + Filament + Spatie payload bloat)
**/vendor/
laravel/vendor/

# Ruflo + Claude orchestration data
ruflo/
ruflo/**/node_modules/

# Agents dirs (transcripts, JSON, prompts)
.agents/
bashscripts/ai/.agents/
.claude-flow/
.claude/projects/

# BMAD raw artifacts (read-only outputs)
_bmad-output/raw/
_bmad-output/**/dist/

# Build / dist artifacts
dist/
build/
out/
.cache/
.turbo/
public/build/
laravel/public/build/

# Logs and output dumps
*.log
*.txt
phpstan_output.txt
report.txt
modules_phpstan_v2.txt
xot_phpstan.txt
user_phpstan*.txt
server.log
composer-update.log
git-conflicts-*.txt

# Playwright + Storybook third-party notices (~1.5MB each)
**/ThirdPartyNotices.txt
**/THIRD_PARTY_NOTICES*

# Large data files
public_html/data/tickets_big.json
public_html/data/*.json
public_html/themes/**/dist/**

# Test artifacts
test-results/
playwright-report/
.phpunit.cache/

# Generated IDE helpers
_ide_helper_models.php
_ide_helper.php
.phpstorm.meta.php

# Vector DBs / sqlite blobs
*.rvf
*.rvf.lock
ruvector.db
agentdb*
*.sqlite

# PDF / docs dumps
bashscripts/pdf/

# QMD cache (always outside repo, but defensive)
.cache/qmd-*
.qmd/
