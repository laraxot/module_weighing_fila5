{
    "name": "laraxot/base_roosko_fila5",
    "description": "Roosko: gestione rifiuti in impianto di trattamento e cernita (Laraxot, Laravel 13, Filament 5)",
    "type": "laravel-module",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-ide-helper": "^2.1.0",
        "carbon-cli/carbon-cli": "*",
        "filament/filament": "*",
        "filament/forms": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^3.0",
        "spatie/laravel-permission": "^5.0",
        "thecodingmachine/safe": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "*",
        "phpstan/phpstan-phpunit": "^2.0",
        "thecodingmachine/phpstan-safe-rule": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\User\\": "laravel/Modules/User/app/",
            "Modules\\Xot\\": "laravel/Modules/Xot/app/"
        },
        "files": [
            "laravel/Modules/User/app/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\User\\Providers\\UserServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
