{
  "version": "0.1",
  "description": "Project MCP Servers Configuration",
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {},
      "type": "stdio"
    },
    "token-optimizer": {
      "command": "npx",
      "args": [
        "-y",
        "token-optimizer-mcp@2.17.0"
      ],
      "env": {
        "TOKEN_OPTIMIZER_CACHE_DIR": "${HOME}/.cache/fixcity/token-optimizer-cache"
      },
      "type": "stdio"
    },
    "sqlite": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-sqlite",
        "--db-path",
        "./laravel/database/test_data.sqlite"
      ],
      "env": {}
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "type": "stdio"
    },
    "context-mode": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "context-mode@1.0.169"
      ],
      "env": {}
    },
    "qmd": {
      "env": {},
      "type": "stdio",
      "description": "QMD second-brain MCP server using the project wrapper for Node 22 and XDG cache discipline.",
      "command": "qmd",
      "args": [
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--browser",
        "chromium",
        "--output-dir",
        "/tmp/playwright-mcp",
        "--timeout-navigation",
        "90000",
        "--timeout-action",
        "90000"
      ],
      "type": "stdio",
      "description": "Official Playwright MCP (@playwright/mcp). Pre-install: npx @playwright/mcp install-browser chrome-for-testing. Doc: docs/wiki/concepts/playwright-mcp-browser-automation.md"
    },
    "laravel-boost": {
      "command": "bash",
      "args": [
        "-c",
        "exec php \"$(git rev-parse --show-toplevel)/laravel/artisan\" boost:mcp"
      ],
      "env": {
        "APP_ENV": "local"
      },
      "type": "stdio",
      "description": "Laravel Boost MCP server (artisan boost:mcp). APP_ENV=local because laravel/.env uses APP_ENV=testing, which makes Boost disable itself (runningUnitTests). Path resolved from the git root so it works from any subdirectory."
    },
    "flowbite": {
      "command": "npx",
      "args": [
        "-y",
        "flowbite-mcp@1.1.5"
      ],
      "type": "stdio",
      "description": "Flowbite component context on demand. This does not make Flowbite a runtime dependency of the application."
    },
    "gsc": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-google-search-console@1.2.0"
      ],
      "env": {}
    }
  }
}
