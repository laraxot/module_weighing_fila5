# Generato da sync-env-testing.sh — NON editare a mano salvo eccezioni documentate.
# Sorgente: laravel/.env | Rigenerare: ./bashscripts/tools/sync-env-testing.sh
# Regola: identico a .env tranne DB_DATABASE* → valore + _test
#
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://fixcity.local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306


DB_DATABASE_USER=fixcity_user_test
DB_USERNAME_USER="marco"
DB_PASSWORD_USER="marco"

DB_DATABASE=fixcity_data_test
DB_USERNAME="marco"
DB_PASSWORD="marco"


BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

NEWSAPI_APP_KEY=

MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER=

SCOUT_DRIVER=fulltext

IGNITION_EDITOR=vscode

MIX_PUBLIC_FOLDER=/../public_html


LOG_SLACK_WEBHOOK_URL=REDACTED_SLACK_WEBHOOK_URL

TELESCOPE_ENABLED=false

LIMESURVEY_URL=
LIMESURVEY_USERNAME=
LIMESURVEY_PASSWORD=
LIMEVERSION=5

NETFUN_TOKEN=

IMAP_HOST=somehost.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=root@example.com
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap



MATOMO_URL="https://your.matomo-install.com"
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=
MATOMO_QUEUE="matomotracker"
MATOMO_QUEUE_CONNECTION="default"


