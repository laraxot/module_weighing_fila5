<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="random"
         processIsolation="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
>
    <!-- Parallel Execution Configuration for FixCity Test Suite -->
    <!--
        This configuration enables parallel test execution with:
        - testsuiteOrder: randomized execution order to detect interdependencies
        - processIsolation: each test runs in separate process (safer with parallel)
        - Multiple test groups for CI/CD pipeline optimization

        Usage:
            php vendor/bin/phpunit --configuration=phpunit-parallel.xml --processes=4

        For CI/CD pipelines, split into groups:
            - Group 1: Unit Tests (4 parallel jobs, ~12s)
            - Group 2: Integration Tests (2 parallel jobs, ~25s)
            - Group 3: Feature Tests (1 job, ~50s, cannot parallelize HTTP tests)
    -->

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Parallel Test Groups for CI/CD Optimization -->
        <testsuite name="UnitModels">
            <directory>tests/Unit/Modules</directory>
            <exclude>tests/Unit/Modules/*/Actions</exclude>
            <exclude>tests/Unit/Modules/*/Services</exclude>
        </testsuite>

        <testsuite name="UnitActions">
            <directory>tests/Unit/Modules/*/Actions</directory>
        </testsuite>

        <testsuite name="UnitServices">
            <directory>tests/Unit/Modules/*/Services</directory>
        </testsuite>

        <testsuite name="IntegrationCrossModule">
            <directory>tests/Integration/Modules/CrossModule</directory>
        </testsuite>

        <testsuite name="FeatureWorkflows">
            <directory>tests/Feature/Modules</directory>
        </testsuite>

        <!-- Critical Path Test Group (run first) -->
        <testsuite name="Critical">
            <directory>tests/Unit/Modules/User</directory>
            <directory>tests/Unit/Modules/Xot</directory>
            <directory>tests/Unit/Modules/Blog</directory>
            <directory>tests/Integration/Modules/CrossModule</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
            <directory>Modules/*/app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Parallel execution specific settings -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>

    <!-- Coverage Configuration -->
    <coverage processUncoveredFiles="true"
              ignoreDeprecatedCodeUnits="true"
              disableCodeCoverageIgnore="false">
        <include>
            <directory suffix=".php">app</directory>
            <directory suffix=".php">Modules/*/app</directory>
        </include>
        <report>
            <text outputFile="php://stdout" showUncoveredFiles="true"/>
            <html outputDirectory="tests/coverage-report" lowUpperBound="50" highLowerBound="80"/>
            <clover outputFile="tests/coverage.xml"/>
        </report>
    </coverage>
</phpunit>
