APP_NAME=FixCity
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_PRODUCTION_KEY
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=https://fixcity.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mariadb
DB_HOST=SECURE_DB_HOST
DB_PORT=3306

DB_DATABASE=SECURE_DB_NAME
DB_USERNAME=SECURE_DB_USER
DB_PASSWORD=USE_ENVIRONMENT_VARIABLE

DB_DATABASE_USER=SECURE_DB_NAME_USER
DB_USERNAME_USER=SECURE_DB_USER
DB_PASSWORD_USER=USE_ENVIRONMENT_VARIABLE

BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis
SESSION_LIFETIME=60

REDIS_HOST=SECURE_REDIS_HOST
REDIS_PASSWORD=USE_ENVIRONMENT_VARIABLE
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=SECURE_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=SECURE_MAIL_USER
MAIL_PASSWORD=USE_ENVIRONMENT_VARIABLE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@DOMINIO_DEL_SERVIZIO
MAIL_FROM_NAME="Nome del servizio"

AWS_ACCESS_KEY_ID=USE_ENVIRONMENT_VARIABLE
AWS_SECRET_ACCESS_KEY=USE_ENVIRONMENT_VARIABLE
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=fixcity-prod

PUSHER_APP_ID=USE_ENVIRONMENT_VARIABLE
PUSHER_APP_KEY=USE_ENVIRONMENT_VARIABLE
PUSHER_APP_SECRET=USE_ENVIRONMENT_VARIABLE
PUSHER_APP_CLUSTER=eu

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SCOUT_DRIVER=meilisearch

IGNITION_EDITOR=vscode

MIX_PUBLIC_FOLDER=/../public_html

TELESCOPE_ENABLED=false

# ===== SECURITY: Use environment variables for all sensitive data =====
# API Keys should be stored in secrets management system
# GOOGLE_MAPS_API_KEY - use environment variable
# FILAMENT_GOOGLE_MAPS_SERVER_API_KEY - use environment variable
# SUPERMEMORY_API_KEY - use environment variable
# IMAP credentials - use environment variables
# Matomo tokens - use environment variables

# ===== PRODUCTION SECURITY SETTINGS =====
FORCE_HTTPS=true
SECURE_COOKIES=true
SECURE_HEADERS=true
# Le tre chiavi sopra non le legge nessun file di config. Quelle lette davvero (DCP-139, verifica: bashscripts/tools/security/production-checklist.sh):
SESSION_SECURE_COOKIE=true
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_MODE=report-only
SECURITY_HSTS_MAX_AGE=31536000

# Proxy e host fidati (G-09, DCP-282). Valori di esempio: nessun segreto.
# TRUSTED_PROXIES: IP o CIDR separati da virgola dei proxy/load balancer davanti all'app (leggono X-Forwarded-Proto/Host/For).
# Vuoto o assente = 127.0.0.1 (solo il proxy locale, come in sviluppo). Dietro un load balancer indicare il suo IP o la sua rete.
# Se e' sbagliato l'app non vede HTTPS: HSTS non parte e gli URL escono http. Non usare * senza firewall davanti.
TRUSTED_PROXIES=127.0.0.1
# TRUSTED_HOSTS: nomi host esatti, senza porta, separati da virgola, che l'app accetta nell'header Host (sito e alias www).
# Vuoto = nessuna restrizione (non va bene in produzione: l'header Host finisce in sitemap e canonical).
# Impostata, ogni altro Host riceve 400. Deve includere l'host di APP_URL. Non vale con APP_ENV=local.
TRUSTED_HOSTS=segnala.comune-esempio.it,www.segnala.comune-esempio.it

# Rate limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_DECAY=15

# ===== MONITORING =====
SENTRY_LARAVEL_DSN=
# LOG_CHANNEL resta 'stack' (riga 8): il canale 'sentry' non esiste in config/logging.php e sentry/sentry-laravel non e' installato.
# Per usare Sentry: composer require sentry/sentry-laravel, definire il canale, poi impostare LOG_CHANNEL.
