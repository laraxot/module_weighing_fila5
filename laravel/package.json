{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "cd Themes/Sixteen && npm run dev",
        "build": "vite build",
        "prepare": "husky install",
        "test": "./vendor/bin/pest",
        "test:coverage": "./vendor/bin/pest --coverage --min=80",
        "test:xot": "./vendor/bin/pest Modules/Xot/tests",
        "phpstan": "./vendor/bin/phpstan analyse --configuration=phpstan.neon",
        "pint": "./vendor/bin/pint",
        "pint:test": "./vendor/bin/pint --test",
        "lint:js": "eslint resources Themes/Sixteen/resources --ext .js,.mjs,.cjs,.ts,.tsx",
        "lint:css": "stylelint $(find resources Themes/Sixteen/resources -type f \\( -name '*.css' -o -name '*.scss' \\) -print)",
        "lint:markdown": "markdownlint \"../**/*.md\" --ignore \"../node_modules/**\" --ignore \"../laravel/vendor/**\"",
        "lint:sh": "bash scripts/quality-shell.sh",
        "complexity": "php analyze_complexity.php",
        "quality:php": "npm run phpstan && npm run pint:test && npm run test",
        "quality:frontend": "npm run lint:js && npm run lint:css",
        "quality": "npm run quality:php && npm run quality:frontend && npm run lint:sh",
        "ci": "npm run quality && npm run complexity"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.17.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^17.13.0",
        "htmlhint": "^1.7.1",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^1.2.0",
        "markdownlint-cli": "^0.45.0",
        "playwright-core": "^1.59.1",
        "postcss": "^8.4.47",
        "prettier": "^3.6.2",
        "puppeteer": "^24.40.0",
        "stylelint": "^16.24.0",
        "stylelint-config-standard": "^39.0.0",
        "tailwindcss": "^3.4.13",
        "typescript-eslint": "^8.45.0",
        "vite": "^6.4.2"
    },
    "dependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/line-clamp": "^0.4.4",
        "@tailwindcss/typography": "^0.5.19",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "lit": "^3.3.2"
    }
}
