{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "FixCity Platform - Laravel Skeleton Application",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Factories\\": "database/factories/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan vendor:publish --tag=cookie-public --force",
            "@php artisan vendor:publish --tag=xot-assets --force"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "go": [
            "@php composer update -W",
            "@php artisan vendor:publish --all",
            "rm -rf database/migrations/*",
            "rm -rf app/View/Components",
            "mkdir -p bootstrap/cache",
            "@putenv CACHE_STORE=array",
            "@php -d memory_limit=-1 artisan optimize:clear --ansi",
            "@php artisan migrate",
            "@php artisan optimize",
            "@php artisan filament:optimize"
        ],
        "guard:fixcity-wizard": [
            "bash bashscripts/quality/check-fixcity-wizard-guards.sh"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "codewithkyrian/transformers-libsloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "barryvdh/laravel-ide-helper": "*",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.7",
        "squizlabs/php_codesniffer": "^3.13",
        "thecodingmachine/phpstan-safe-rule": "^1.4"
    }
}
