{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "openrouter": {
            "options": {
                "plugins": [
                    {
                        "id": "context-compression"
                    }
                ]
            }
        }
    },
    "compaction": {
        "auto": true,
        "prune": true
    },
    "watcher": {
        "ignore": [
            "**/node_modules/**",
            "**/vendor/**",
            "**/storage/clockwork/**",
            "**/test-results/**",
            "**/_bmad-output/**",
            "**/.bmad-output/**",
            "**/docs/archive/**",
            "**/docs/consolidated/**"
        ]
    },
    "agent": {
        "analyst": {
            "prompt": "{file:../_bmad/agents/analyst.md}"
        },
        "architect": {
            "prompt": "{file:../_bmad/agents/architect.md}"
        },
        "bmad-master": {
            "prompt": "{file:../_bmad/agents/bmad-master.md}"
        },
        "bmad-orchestrator": {
            "prompt": "{file:../_bmad/agents/bmad-orchestrator.md}"
        },
        "dev": {
            "prompt": "{file:../_bmad/agents/dev.md}"
        },
        "pm": {
            "prompt": "{file:../_bmad/agents/pm.md}"
        },
        "po": {
            "prompt": "{file:../_bmad/agents/po.md}"
        },
        "qa": {
            "prompt": "{file:../_bmad/agents/qa.md}"
        },
        "sm": {
            "prompt": "{file:../_bmad/agents/sm.md}"
        },
        "ux-expert": {
            "prompt": "{file:../_bmad/agents/ux-expert.md}"
        }
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        },
        "context-mode": {
            "type": "local",
            "command": [
                "context-mode"
            ],
            "enabled": true
        },
        "qmd": {
            "type": "local",
            "command": [
                "qmd",
                "--index",
                "fixcity",
                "mcp"
            ],
            "enabled": true,
            "environment": {
                "XDG_CONFIG_HOME": "{env:HOME}/.cache/fixcity/qmd-config",
                "XDG_CACHE_HOME": "{env:HOME}/.cache/fixcity/qmd-cache",
                "HOME": "{env:HOME}/.cache/fixcity/qmd-home"
            }
        }
    },
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ]
}
