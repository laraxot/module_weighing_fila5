{
    "name": "laraxot/module_labeling_fila5",
    "description": "Generic labeling module for the Laraxot ecosystem: QR/barcode/RFID/NFC identifiers, ZPL and PDF label templates, printers and print history.",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_labeling",
        "qrcode",
        "zpl",
        "rfid",
        "labels"
    ],
    "homepage": "https://github.com/laraxot/module_labeling_fila5",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Sottana",
            "email": "marco.sottana@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Labeling\\Providers\\LabelingServiceProvider",
                "Modules\\Labeling\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": []
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Labeling\\": "app/",
            "Modules\\Labeling\\Database\\Factories\\": "database/factories/",
            "Modules\\Labeling\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Labeling\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "chillerlan/php-qrcode": "*"
    },
    "require-dev": {},
    "repositories_comment": [
        {
            "type": "path",
            "url": "../Xot"
        }
    ],
    "scripts": {
        "post-autoload-dump": [],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "lint": [
            "@php vendor/bin/pint",
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
